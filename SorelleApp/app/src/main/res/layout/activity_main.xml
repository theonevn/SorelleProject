<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sorelle_fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SORELLE"
                    android:fontFamily="@font/cormorant_semibold"
                    android:textSize="30sp"
                    android:letterSpacing="0.15"
                    android:textColor="@color/sorelle_marrom" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESSENCE"
                    android:textSize="11sp"
                    android:letterSpacing="0.3"
                    android:textColor="@color/sorelle_marrom" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSacola"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Sacola"
                android:textSize="12sp"
                android:textColor="@color/sorelle_marrom"
                app:strokeColor="@color/sorelle_dourado"
                app:cornerRadius="22dp" />
        </LinearLayout>

        <!-- Cartão principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card_verde">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COSMÉTICOS DA AMAZÔNIA"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textColor="@color/sorelle_dourado" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Beleza que regenera a vida."
                android:fontFamily="@font/cormorant_semibold"
                android:textSize="40sp"
                android:lineSpacingMultiplier="0.95"
                android:textColor="@color/white"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alta performance em harmonia com a natureza. Plantamos árvores nativas por você."
                android:textSize="16sp"
                android:textColor="@color/sorelle_bege_card"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnProdutos"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Conheça os Produtos"
                android:textColor="@color/sorelle_marrom"
                android:backgroundTint="@color/sorelle_fundo"
                app:cornerRadius="28dp" />
        </LinearLayout>

        <!-- Destaques -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destaques"
            android:fontFamily="@font/cormorant_semibold"
            android:textSize="28sp"
            android:textColor="@color/sorelle_marrom"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Destaque 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDestaque1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        app:cardBackgroundColor="@color/sorelle_bege_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/ivDestaque1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Foto do produto em destaque"
                            tools:src="@drawable/serum_acai" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvDestaqueNome1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/sorelle_marrom"
                        tools:text="Sérum Açaí" />

                    <TextView
                        android:id="@+id/tvDestaquePreco1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/sorelle_marrom"
                        tools:text="R$ 89,90" />

                    <TextView
                        android:id="@+id/tvDestaqueArvores1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/sorelle_verde"
                        tools:text="+1 árvore" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDestaque2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        app:cardBackgroundColor="@color/sorelle_bege_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/ivDestaque2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Foto do produto em destaque"
                            tools:src="@drawable/creme_castanha" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvDestaqueNome2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/sorelle_marrom"
                        tools:text="Creme Castanha" />

                    <TextView
                        android:id="@+id/tvDestaquePreco2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/sorelle_marrom"
                        tools:text="R$ 55,90" />

                    <TextView
                        android:id="@+id/tvDestaqueArvores2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/sorelle_verde"
                        tools:text="+3 árvores" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <Button
            android:id="@+id/btnImpact"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Ver meu impacto"
            android:textColor="@color/sorelle_marrom"
            app:strokeColor="@color/sorelle_dourado"
            app:cornerRadius="28dp" />

        <TextView
            android:id="@+id/tvSair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="Sair"
            android:textColor="@color/sorelle_marrom"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>